RECODE_HTTP_ADDRESS=:8080
RECODE_SHUTDOWN_TIMEOUT=10s
# Docker Compose uses this value when it initializes its PostgreSQL volume.
RECODE_POSTGRES_PASSWORD=recode_dev
# Containers reach PostgreSQL through its Compose service name.
RECODE_COMPOSE_DATABASE_URL=postgres://recode:recode_dev@postgres:5432/recode?sslmode=disable
# Host-native backend commands use the published development port.
RECODE_DATABASE_URL=postgres://recode:recode_dev@localhost:5433/recode?sslmode=disable
RECODE_REDIS_ADDRESS=localhost:6379
RECODE_QUEUE_NAME=recode:jobs
RECODE_STORAGE_ROOT=./data
RECODE_UPLOAD_MAX_BYTES=1073741824
RECODE_RESULT_RETENTION=2h
RECODE_FFMPEG_PATH=ffmpeg
RECODE_FFPROBE_PATH=ffprobe
